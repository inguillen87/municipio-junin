# Los artefactos GRH quedan fuera del deployment por defecto. Sólo se incluye
# una excepción agregada y validada que no contiene fichas ni identificadores.
dist/**
frontend/node_modules/**
api/_data/*.json
!api/_data/grh-absence-insights.json
docs/data/*.json

# Componentes y evidencia que no forman parte del runtime Serverless.
# prisma/ se conserva: el postinstall raíz lo necesita para generar el cliente.
backend/**
database/**
migrations/**
docs/**
tests/**
scripts/**
config/**
*.md
*.sql
*.sql.gz
*.py
