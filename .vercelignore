# Los artefactos GRH quedan fuera del deployment por defecto. Sólo se incluye
# excepciones agregadas y validadas que no contienen fichas ni identificadores.
dist/**
frontend/node_modules/**
api/_data/*.json
!api/_data/grh-absence-insights.json
!api/_data/grh-import-quality-history.json
!api/_data/grh-employment-actions.json
!api/_data/grh-payroll-run-control.json
!api/_data/grh-personas-linkage-readiness.json
docs/data/*.json

# Componentes y evidencia que no forman parte del runtime Serverless.
# prisma/ se conserva: el postinstall raíz lo necesita para generar el cliente.
backend/**
database/**
migrations/**
docs/**
tests/**
scripts/**
config/**
*.md
*.sql
*.sql.gz
*.py
