# ============================================================
# Variables de entorno — API Backend
# Copiar como .env y completar valores reales
# NUNCA commitear .env
# ============================================================

# Servidor
PORT=3001
NODE_ENV=development

# Base de datos (si no está disponible, usa datos en memoria)
DATABASE_URL=postgresql://junin_user:password@localhost:5432/junin_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=junin_db
DB_USER=junin_user
DB_PASSWORD=cambiar_en_produccion

# JWT
JWT_SECRET=clave_super_secreta_minimo_32_caracteres
JWT_EXPIRES_IN=24h

# Frontend (CORS)
FRONTEND_URL=http://localhost:8080
VERCEL_URL=https://municipio-junin.vercel.app

# Archivos
UPLOAD_MAX_MB=50
UPLOAD_DIR=./uploads
