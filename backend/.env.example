# ── SERVIDOR ────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ── JWT ─────────────────────────────────────────────────────
# Mínimo 32 caracteres; generar con entropía real:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=8h

# CUID exacto del tenant propietario de las tablas legacy sin tenant_id.
# No usar el slug. Si queda vacío, analytics falla cerrado.
LEGACY_ANALYTICS_TENANT_ID=
GRH_TENANT_ID=
# SHA-256 exacto del backup GRH aprobado. Toda lectura desde DB falla cerrada
# si falta, no tiene 64 hex minúsculos o no coincide con profile + semantic.
GRH_SOURCE_SHA256=
# IDs exactos (separados por coma) de usuarios municipales no publicados que
# pueden consultar el directorio nominal GRH. Los perfiles públicos quedan fuera.
GRH_DIRECTORY_ALLOWED_USER_IDS=
# Clave persistente AES-256-GCM (32 bytes, base64url canonico) para descifrar el
# snapshot nominal privado. Cargar como sensitive; nunca reutilizar JWT_SECRET.
GRH_DIRECTORY_SNAPSHOT_KEY_V1=
# Secreto efímero para la Function one-shot de materialización. Se carga como
# sensitive sólo durante la operación y se elimina antes del deploy estable.
GRH_DIRECTORY_BOOTSTRAP_SECRET=

# Revisión privada GRH + PERSONAS. Deben ser dos claves base64url canónicas de
# 32 bytes, distintas entre sí y de JWT/directorio. La primera genera
# referencias opacas sólo durante materialización/publicación y se retira al
# terminar; no pertenece al runtime estable. La segunda cifra la evidencia
# nominal y es la única que conserva el runtime privado de lectura.
GRH_PERSONAS_REVIEW_HMAC_KEY_V1=
GRH_PERSONAS_REVIEW_EVIDENCE_KEY_V1=
# Separación de funciones: IDs municipales habilitados para consultar la cola
# y subconjunto independiente habilitado para decidir. Un decisor necesita
# figurar en ambas listas; nunca reutilizar GRH_DIRECTORY_ALLOWED_USER_IDS.
GRH_PERSONAS_REVIEW_READ_ALLOWED_USER_IDS=
GRH_PERSONAS_REVIEW_DECISION_ALLOWED_USER_IDS=
# Sólo para el publicador operativo; no se configura en el runtime estable.
GRH_PERSONAS_REVIEW_PUBLISH_DATABASE_URL=

# Cubo financiero GRH: el runtime productivo lee exclusivamente el snapshot
# cifrado activo. La clave persistente y la credencial de publicacion deben ser
# distintas; el secreto bootstrap existe solo durante el deployment one-shot y
# debe eliminarse antes de promover el alias estable.
GRH_WORKFORCE_FINANCE_ARTIFACT_SOURCE=encrypted_snapshot
GRH_WORKFORCE_FINANCE_SNAPSHOT_KEY_V1=
GRH_WORKFORCE_FINANCE_SNAPSHOT_PUBLISH_DATABASE_URL=
GRH_WORKFORCE_FINANCE_BOOTSTRAP_SECRET=

# Fuente privada de runtime: `database` es el destino estable. `sealed` permite
# una demostracion historica de solo lectura cuando el rol disponible no puede
# aplicar la migracion; exige el bundle gzip+base64 sensible y el mismo pin SHA.
GRH_ARTIFACT_SOURCE=database
# Configurar una sola modalidad como secreto de plataforma; nunca pegar valores
# en Git/docs. Para la modalidad directa, descomentar la siguiente variable:
# GRH_SEALED_BUNDLE_BASE64=
# Alternativa fragmentada: declarar 2..16 y completar exactamente 01..NN. La
# variable directa debe permanecer ausente porque, si existe, tiene precedencia.
GRH_SEALED_BUNDLE_PARTS=
GRH_SEALED_BUNDLE_01=
GRH_SEALED_BUNDLE_02=
# GRH_SEALED_BUNDLE_03= ... GRH_SEALED_BUNDLE_16=

# Conexion opcional para `scripts/inspect-grh-runtime.mjs` durante una
# inspeccion operativa manual. No la consumen la API ni el runtime de Vercel.
# Usar una credencial de solo lectura y nunca guardar un valor real aqui.
GRH_INSPECTION_DATABASE_URL=

# Sólo permite leer api/_data en desarrollo; nunca habilitar en producción.
ALLOW_LOCAL_GRH_ARTIFACTS=false

# Secreto distinto de JWT_SECRET para invocaciones internas autorizadas.
# El nombre se conserva por compatibilidad; no existe hoy un cron programado.
CRON_SECRET=

# ── BASE DE DATOS (Neon PostgreSQL) ─────────────────────────
# Obtener en: https://neon.tech → tu proyecto → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=verify-full
# DIRECT_URL se usa para migraciones con Prisma (misma URL sin pooler)
DIRECT_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=verify-full

# Gate de migraci\u00f3n. Estos IDs no son secretos, pero deben coincidir con el
# manifest revisado. El receipt conectado es ef\u00edmero, externo al checkout y se
# fija por SHA-256; nunca guardar DATABASE_URL ni credenciales dentro de \u00e9l.
PRISMA_BASELINE_ID=
PRISMA_MIGRATION_SET_ID=
PRISMA_TARGET_ID=
PRISMA_DRIFT_RECEIPT_PATH=
PRISMA_DRIFT_RECEIPT_SHA256=

# ── WHATSAPP META API ────────────────────────────────────────
# Obtener en: developers.facebook.com → tu app → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_ID_VECINOS=

# Diagnóstico deshabilitado por defecto. WHATSAPP_TEST_TO se usa sólo en una
# prueba aprobada cuando ENABLE_WHATSAPP_DIAGNOSTICS=true.
ENABLE_WHATSAPP_DIAGNOSTICS=false
WHATSAPP_TEST_TO=

# Origen público certificado para enlaces salientes y allowlist CORS exacta.
PUBLIC_APP_URL=
PUBLIC_APP_ORIGINS=

# Conectores PostgreSQL: lista exacta de hosts autorizados, separada por comas.
# DATA_CONNECTOR_ALLOW_PRIVATE debe permanecer false en produccion salvo una
# decision de red documentada.
DATA_CONNECTOR_ALLOWED_HOSTS=
DATA_CONNECTOR_ALLOW_PRIVATE=false

# ── APROVISIONAMIENTO RETIRADO ───────────────────────────────
# db:seed es un gate fail-closed: termina con código 1 y
# ACCOUNT_LIFECYCLE_NOT_GOVERNED. No acepta secretos ni conecta a PostgreSQL.
# No agregar variables de seed hasta implementar invitación de un solo uso,
# MFA, sesiones revocables, doble aprobación/SoD y auditoría transaccional.
