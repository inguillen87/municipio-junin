{
  "name": "municipio-junin-api",
  "version": "1.0.0",
  "description": "API REST — Sistema de Gestión Municipal Junín",
  "main": "server.js",
  "engines": {
    "node": ">=22.3.0 <25"
  },
  "scripts": {
    "test": "node ../scripts/run-test-suite.mjs backend",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "postinstall": "prisma generate --schema ../prisma/schema.prisma --generator backendClient",
    "seed": "node seed.js",
    "db:validate": "prisma validate --schema ../prisma/schema.prisma",
    "db:generate": "prisma generate --schema ../prisma/schema.prisma --generator backendClient",
    "db:baseline:status": "node ../scripts/assert-prisma-migrations.mjs --offline --json",
    "db:migrate": "node ../scripts/assert-prisma-migrations.mjs --release && prisma migrate deploy --schema ../prisma/schema.prisma",
    "db:status": "prisma migrate status --schema ../prisma/schema.prisma",
    "db:seed": "node seed.js",
    "db:studio": "prisma studio --schema ../prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "prisma": "^5.22.0"
  }
}
