# ============================================================
# Variables de entorno — Municipalidad de Junín
# COPIAR ESTE ARCHIVO COMO .env Y COMPLETAR LOS VALORES
# NUNCA COMMITEAR .env AL REPOSITORIO
# ============================================================

# ── BASE DE DATOS ─────────────────────────────
DB_PASSWORD=cambiar_esto_en_produccion
JWT_SECRET=clave_super_secreta_minimo_32_caracteres_cambiar

# ── MINIO (almacenamiento archivos) ────────────────
MINIO_USER=junin_admin
MINIO_PASSWORD=cambiar_password_minio

# ── PGADMIN ────────────────────────────────
PGADMIN_EMAIL=tecnologia@municipiojunin.gob.ar
PGADMIN_PASSWORD=cambiar_password_pgadmin

# ── APLICACIÓN ───────────────────────────────
NODE_ENV=production
API_PORT=3001
FRONTEND_URL=https://gestion.municipiojunin.gob.ar

# ── EMAIL (notificaciones) ───────────────────────
SMTP_HOST=smtp.municipiojunin.gob.ar
SMTP_PORT=587
SMTP_USER=sistema@municipiojunin.gob.ar
SMTP_PASS=password_smtp
