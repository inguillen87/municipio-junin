model UserSecurityState {
  userId                String                 @id @map("user_id")
  tenantId              String?                @map("tenant_id")
  lifecycleStatus       AccountLifecycleStatus @default(INVITED) @map("lifecycle_status")
  tokenVersion          Int                    @default(1) @map("token_version")
  authorizationVersion  Int                    @default(1) @map("authorization_version")
  mustChangePassword    Boolean                @default(true) @map("must_change_password")
  mfaRequired           Boolean                @default(false) @map("mfa_required")
  failedLoginCount      Int                    @default(0) @map("failed_login_count")
  lockedUntil           DateTime?              @map("locked_until") @db.Timestamptz(6)
  accountExpiresAt      DateTime?              @map("account_expires_at") @db.Timestamptz(6)
  activationCompletedAt DateTime?              @map("activation_completed_at") @db.Timestamptz(6)
  passwordChangedAt     DateTime?              @map("password_changed_at") @db.Timestamptz(6)
  suspendedAt           DateTime?              @map("suspended_at") @db.Timestamptz(6)
  suspendedByUserId     String?                @map("suspended_by_user_id")
  suspensionReasonCode  String?                @map("suspension_reason_code") @db.VarChar(80)
  revokedAt             DateTime?              @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId       String?                @map("revoked_by_user_id")
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, lifecycleStatus])
  @@index([accountExpiresAt])
  @@map("auth_user_security_states")
}

model AuthenticationSession {
  id                     String                 @id @default(cuid())
  tenantId               String?                @map("tenant_id")
  userId                 String                 @map("user_id")
  status                 SessionStatus          @default(ACTIVE)
  authenticationStrength AuthenticationStrength @default(PASSWORD) @map("authentication_strength")
  sessionVersion         Int                    @default(1) @map("session_version")
  tokenVersion           Int                    @map("token_version")
  authorizationVersion   Int                    @map("authorization_version")
  policyVersion          String                 @map("policy_version") @db.VarChar(80)
  mfaAuthenticatorId     String?                @map("mfa_authenticator_id")
  mfaVerifiedAt          DateTime?              @map("mfa_verified_at") @db.Timestamptz(6)
  ipAddressDigest        String?                @map("ip_address_digest") @db.Char(64)
  userAgentDigest        String?                @map("user_agent_digest") @db.Char(64)
  issuedAt               DateTime               @default(now()) @map("issued_at") @db.Timestamptz(6)
  lastSeenAt             DateTime               @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  idleExpiresAt          DateTime               @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt      DateTime               @map("absolute_expires_at") @db.Timestamptz(6)
  expiredAt              DateTime?              @map("expired_at") @db.Timestamptz(6)
  revokedAt              DateTime?              @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId        String?                @map("revoked_by_user_id")
  revocationReasonCode   String?                @map("revocation_reason_code") @db.VarChar(80)
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, status])
  @@index([tenantId, status])
  @@index([absoluteExpiresAt])
  @@index([mfaAuthenticatorId, status])
  @@map("auth_sessions")
}

// Registro comun de MFA. No contiene secretos ni claves publicas/privadas.
// WebAuthn y TOTP guardan material exclusivamente mediante referencias
// cifradas/KMS y digests en sus modelos especializados.
model MfaAuthenticator {
  id                          String                 @id @default(cuid())
  tenantId                    String                 @map("tenant_id")
  userId                      String                 @map("user_id")
  kind                        MfaAuthenticatorKind
  status                      MfaAuthenticatorStatus @default(ISSUED)
  authenticationStrength      AuthenticationStrength @map("authentication_strength")
  authenticatorVersion        Int                    @default(1) @map("authenticator_version")
  tokenVersionAtIssue         Int                    @map("token_version_at_issue")
  authorizationVersionAtIssue Int                    @map("authorization_version_at_issue")
  policyVersion               String                 @map("policy_version") @db.VarChar(80)
  issuedByUserId              String?                @map("issued_by_user_id")
  issuedAt                    DateTime               @default(now()) @map("issued_at") @db.Timestamptz(6)
  enrolledAt                  DateTime?              @map("enrolled_at") @db.Timestamptz(6)
  firstUsedAt                 DateTime?              @map("first_used_at") @db.Timestamptz(6)
  lastUsedAt                  DateTime?              @map("last_used_at") @db.Timestamptz(6)
  expiresAt                   DateTime?              @map("expires_at") @db.Timestamptz(6)
  expiredAt                   DateTime?              @map("expired_at") @db.Timestamptz(6)
  suspendedAt                 DateTime?              @map("suspended_at") @db.Timestamptz(6)
  revokedAt                   DateTime?              @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId             String?                @map("revoked_by_user_id")
  revocationReasonCode        String?                @map("revocation_reason_code") @db.VarChar(80)
  createdAt                   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, userId, status])
  @@index([userId, kind, status])
  @@index([status, expiresAt])
  @@map("auth_mfa_authenticators")
}

// Los challenges WebAuthn/TOTP son de un uso y se conservan solo por digest.
// bindingDigest fija RP/origin/options/session canonicalizados sin guardarlos
// como un payload libre susceptible de contener material sensible.
model MfaChallenge {
  id                          String              @id @default(cuid())
  tenantId                    String              @map("tenant_id")
  userId                      String              @map("user_id")
  sessionId                   String?             @map("session_id")
  authenticatorId             String?             @map("authenticator_id")
  purpose                     MfaChallengePurpose
  status                      MfaChallengeStatus  @default(ISSUED)
  challengeDigest             String              @unique @map("challenge_digest") @db.Char(64)
  bindingDigest               String              @map("binding_digest") @db.Char(64)
  pepperKeyId                 String              @map("pepper_key_id") @db.VarChar(120)
  sessionVersionAtIssue       Int?                @map("session_version_at_issue")
  tokenVersionAtIssue         Int                 @map("token_version_at_issue")
  authorizationVersionAtIssue Int                 @map("authorization_version_at_issue")
  policyVersion               String              @map("policy_version") @db.VarChar(80)
  maxAttempts                 Int                 @default(5) @map("max_attempts")
  failedAttempts              Int                 @default(0) @map("failed_attempts")
  issuedAt                    DateTime            @default(now()) @map("issued_at") @db.Timestamptz(6)
  usedAt                      DateTime?           @map("used_at") @db.Timestamptz(6)
  expiresAt                   DateTime            @map("expires_at") @db.Timestamptz(6)
  expiredAt                   DateTime?           @map("expired_at") @db.Timestamptz(6)
  revokedAt                   DateTime?           @map("revoked_at") @db.Timestamptz(6)
  revocationReasonCode        String?             @map("revocation_reason_code") @db.VarChar(80)
  createdAt                   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, userId, purpose, status])
  @@index([sessionId, status])
  @@index([authenticatorId, status])
  @@index([status, expiresAt])
  @@map("auth_mfa_challenges")
}

model WebAuthnCredential {
  id                       String    @id @default(cuid())
  tenantId                 String    @map("tenant_id")
  userId                   String    @map("user_id")
  authenticatorId          String    @unique @map("authenticator_id")
  credentialIdDigest       String    @unique @map("credential_id_digest") @db.Char(64)
  encryptedKeyRef          String    @unique @map("encrypted_key_ref") @db.VarChar(500)
  keyId                    String    @map("key_id") @db.VarChar(120)
  encryptedMaterialDigest  String    @map("encrypted_material_digest") @db.Char(64)
  rpIdDigest               String    @map("rp_id_digest") @db.Char(64)
  originPolicyVersion      String    @map("origin_policy_version") @db.VarChar(80)
  signCount                BigInt    @default(0) @map("sign_count")
  backupEligible           Boolean   @default(false) @map("backup_eligible")
  backupState              Boolean   @default(false) @map("backup_state")
  discoverable             Boolean   @default(false)
  userVerificationRequired Boolean   @default(true) @map("user_verification_required")
  lastSignCountAt          DateTime? @map("last_sign_count_at") @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, userId])
  @@index([rpIdDigest])
  @@index([keyId])
  @@map("auth_webauthn_credentials")
}

model TotpAuthenticator {
  id                      String        @id @default(cuid())
  tenantId                String        @map("tenant_id")
  userId                  String        @map("user_id")
  authenticatorId         String        @unique @map("authenticator_id")
  encryptedKeyRef         String        @unique @map("encrypted_key_ref") @db.VarChar(500)
  keyId                   String        @map("key_id") @db.VarChar(120)
  encryptedMaterialDigest String        @map("encrypted_material_digest") @db.Char(64)
  algorithm               TotpAlgorithm
  digits                  Int
  periodSeconds           Int           @map("period_seconds")
  acceptedSkewWindows     Int           @default(1) @map("accepted_skew_windows")
  lastAcceptedCounter     BigInt?       @map("last_accepted_counter")
  keyVersion              Int           @default(1) @map("key_version")
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, userId])
  @@index([keyId])
  @@map("auth_totp_authenticators")
}

// Cada codigo conserva solo su digest. El valor de recuperacion crudo se
// entrega una vez y nunca se persiste en esta propuesta.
model MfaRecoveryCode {
  id                          String             @id @default(cuid())
  tenantId                    String             @map("tenant_id")
  userId                      String             @map("user_id")
  batchId                     String             @map("batch_id")
  sequence                    Int
  status                      RecoveryCodeStatus @default(ISSUED)
  codeDigest                  String             @unique @map("code_digest") @db.Char(64)
  pepperKeyId                 String             @map("pepper_key_id") @db.VarChar(120)
  tokenVersionAtIssue         Int                @map("token_version_at_issue")
  authorizationVersionAtIssue Int                @map("authorization_version_at_issue")
  policyVersion               String             @map("policy_version") @db.VarChar(80)
  issuedAt                    DateTime           @default(now()) @map("issued_at") @db.Timestamptz(6)
  usedAt                      DateTime?          @map("used_at") @db.Timestamptz(6)
  usedSessionId               String?            @map("used_session_id")
  expiresAt                   DateTime           @map("expires_at") @db.Timestamptz(6)
  expiredAt                   DateTime?          @map("expired_at") @db.Timestamptz(6)
  revokedAt                   DateTime?          @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId             String?            @map("revoked_by_user_id")
  revocationReasonCode        String?            @map("revocation_reason_code") @db.VarChar(80)
  createdAt                   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([batchId, sequence])
  @@index([tenantId, userId, status])
  @@index([batchId, status])
  @@index([status, expiresAt])
  @@map("auth_mfa_recovery_codes")
}

// La sesion no guarda un digest refresh mutable. La familia y cada credencial
// rotada se conservan por separado para reconocer reuse de cualquier secuencia.
model RefreshTokenFamily {
  id                          String                   @id @default(cuid())
  tenantId                    String                   @map("tenant_id")
  userId                      String                   @map("user_id")
  sessionId                   String                   @unique @map("session_id")
  status                      RefreshTokenFamilyStatus @default(ACTIVE)
  familyVersion               Int                      @default(1) @map("family_version")
  currentSequence             Int                      @default(0) @map("current_sequence")
  sessionVersionAtIssue       Int                      @map("session_version_at_issue")
  tokenVersionAtIssue         Int                      @map("token_version_at_issue")
  authorizationVersionAtIssue Int                      @map("authorization_version_at_issue")
  policyVersion               String                   @map("policy_version") @db.VarChar(80)
  issuedAt                    DateTime                 @default(now()) @map("issued_at") @db.Timestamptz(6)
  lastUsedAt                  DateTime?                @map("last_used_at") @db.Timestamptz(6)
  expiresAt                   DateTime                 @map("expires_at") @db.Timestamptz(6)
  expiredAt                   DateTime?                @map("expired_at") @db.Timestamptz(6)
  reuseDetectedAt             DateTime?                @map("reuse_detected_at") @db.Timestamptz(6)
  revokedAt                   DateTime?                @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId             String?                  @map("revoked_by_user_id")
  revocationReasonCode        String?                  @map("revocation_reason_code") @db.VarChar(80)
  createdAt                   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, userId, status])
  @@index([status, expiresAt])
  @@index([reuseDetectedAt])
  @@map("auth_refresh_token_families")
}

model RefreshTokenCredential {
  id                          String                       @id @default(cuid())
  tenantId                    String                       @map("tenant_id")
  userId                      String                       @map("user_id")
  familyId                    String                       @map("family_id")
  sequence                    Int
  status                      RefreshTokenCredentialStatus @default(ISSUED)
  tokenDigest                 String                       @unique @map("token_digest") @db.Char(64)
  pepperKeyId                 String                       @map("pepper_key_id") @db.VarChar(120)
  familyVersionAtIssue        Int                          @map("family_version_at_issue")
  sessionVersionAtIssue       Int                          @map("session_version_at_issue")
  tokenVersionAtIssue         Int                          @map("token_version_at_issue")
  authorizationVersionAtIssue Int                          @map("authorization_version_at_issue")
  policyVersion               String                       @map("policy_version") @db.VarChar(80)
  issuedAt                    DateTime                     @default(now()) @map("issued_at") @db.Timestamptz(6)
  usedAt                      DateTime?                    @map("used_at") @db.Timestamptz(6)
  expiresAt                   DateTime                     @map("expires_at") @db.Timestamptz(6)
  expiredAt                   DateTime?                    @map("expired_at") @db.Timestamptz(6)
  reuseDetectedAt             DateTime?                    @map("reuse_detected_at") @db.Timestamptz(6)
  revokedAt                   DateTime?                    @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId             String?                      @map("revoked_by_user_id")
  revocationReasonCode        String?                      @map("revocation_reason_code") @db.VarChar(80)
  createdAt                   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([familyId, sequence])
  @@index([familyId, status, expiresAt])
  @@index([tenantId, userId, status])
  @@index([reuseDetectedAt])
  @@map("auth_refresh_token_credentials")
}

model OneTimeCredential {
  id                  String                   @id @default(cuid())
  tenantId            String?                  @map("tenant_id")
  userId              String                   @map("user_id")
  purpose             OneTimeCredentialPurpose
  status              OneTimeCredentialStatus  @default(ISSUED)
  tokenDigest         String                   @unique @map("token_digest") @db.Char(64)
  pepperKeyId         String                   @map("pepper_key_id") @db.VarChar(80)
  tokenVersionAtIssue Int                      @map("token_version_at_issue")
  maxAttempts         Int                      @default(5) @map("max_attempts")
  failedAttempts      Int                      @default(0) @map("failed_attempts")
  issuedByUserId      String?                  @map("issued_by_user_id")
  expiresAt           DateTime                 @map("expires_at") @db.Timestamptz(6)
  consumedAt          DateTime?                @map("consumed_at") @db.Timestamptz(6)
  consumedSessionId   String?                  @map("consumed_session_id")
  revokedAt           DateTime?                @map("revoked_at") @db.Timestamptz(6)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, purpose, status])
  @@index([expiresAt])
  @@map("auth_one_time_credentials")
}

model OrgUnit {
  id              String        @id @default(cuid())
  tenantId        String        @map("tenant_id")
