model Ciudadano {
  id        String    @id
  tenantId  String
  nombre    String
  sexo      String?
  fechaNac  DateTime?
  dni       String?
  cuil      String?
  calle     String?
  numero    String?
  barrio    String?
  localidad String?
  latitud   Float?
  longitud  Float?
  telefono  String?
  email     String?
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([dni])
  @@index([tenantId])
  @@map("ciudadanos")
