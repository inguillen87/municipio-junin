// ============================================================
// SCHEMA.PRISMA v2 - GovTech Municipal Platform
// Multi-tenant: Tenants, Users + full municipal data
// DB: Neon PostgreSQL (serverless) via Prisma
// ============================================================

generator client {
  provider = "prisma-client-js"
}

// El backend Express se instala de forma independiente. Generar un cliente
// propio evita que dependa accidentalmente del node_modules del proyecto raíz.
generator backendClient {
  provider = "prisma-client-js"
  output   = "../backend/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  INTENDENTE
  TENANT_ADMIN
  TENANT_USER
  CONTADOR
  INSPECTOR
  DEMO
}

enum Plan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
  TRIAL
  DEMO
}

enum TenantStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  CANCELLED
}

model Tenant {
  id              String       @id @default(cuid())
  slug            String       @unique
  name            String
  shortName       String
  province        String?
  country         String       @default("Argentina")
  population      Int?
  logoUrl         String?
  themePrimary    String       @default("#3b82f6")
  themeAccent     String       @default("#6366f1")
  themeBackground String       @default("#060b18")
  contactEmail    String?
  contactPhone    String?
  website         String?
  plan            Plan         @default(DEMO)
  status          TenantStatus @default(TRIAL)
  trialEndsAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  users           User[]
  empleados       Empleado[]
  pagos           Pago[]
  reclamos        Reclamo[]
  obras           Obra[]
  presupuestos    Presupuesto[]
  licitaciones    Licitacion[]
  auditLogs       AuditLog[]
  documentos      Documento[]
  notificaciones  Notificacion[]
  barrios         Barrio[]         @ignore
  calles          Calle[]          @ignore
  categoriasGrh   CategoriaGrh[]   @ignore
  ciudadanos      Ciudadano[]      @ignore
  conveniosGrh    ConvenioGrh[]    @ignore
  empleadosGrh    EmpleadoGrh[]    @ignore
  gremiosGrh      GremioGrh[]      @ignore
  localidades     Localidad[]      @ignore
  motivosAusencia MotivoAusencia[] @ignore
  sectoresGrh     SectorGrh[]      @ignore

  @@map("tenants")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(TENANT_USER)
  tenantId     String?
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  active       Boolean   @default(true)
  avatar       String?
  lastLogin    DateTime?
  loginCount   Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs    AuditLog[]

  @@map("users")
}

model Empleado {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legajo          String
  nombre          String
  apellido        String
  dni             String?
  cargo           String
  categoria       String?
  secretaria      String
  area            String?
  tipoContrato    String    @default("Planta Permanente")
  salarioBruto    Float
  salarioNeto     Float?
  fechaIngreso    DateTime?
  fechaNacimiento DateTime?
  email           String?
  telefono        String?
  domicilio       String?
  estado          String    @default("Activo")
  observaciones   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantId, legajo])
  @@map("empleados")
}

model Pago {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  numero         String?
  proveedor      String
  cuit           String?
  concepto       String
  secretaria     String
  monto          Float
  moneda         String    @default("ARS")
  fecha          DateTime
  fechaPago      DateTime?
  estado         String    @default("Pagado")
  categoria      String?
  comprobanteUrl String?
  observaciones  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("pagos")
}

model Presupuesto {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  secretaria String
  codigo     String?
  programa   String?
  asignado   Float
  ejecutado  Float    @default(0)
  periodo    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, secretaria, periodo])
  @@map("presupuestos")
}

model Reclamo {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  numero        String
  categoria     String
  subcategoria  String?
  descripcion   String
  estado        String    @default("Pendiente")
  prioridad     String    @default("Media")
  barrio        String?
  domicilio     String?
  lat           Float?
  lng           Float?
  nombre        String?
  telefono      String?
  email         String?
  agente        String?
  fechaAsignado DateTime?
  fechaCierre   DateTime?
  observaciones String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tenantId, numero])
  @@map("reclamos")
}

model Obra {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre           String
  descripcion      String?
  contratista      String?
  monto            Float?
  moneda           String    @default("ARS")
  avance           Int       @default(0)
  estado           String    @default("En ejecucion")
  barrio           String?
  domicilio        String?
  lat              Float?
  lng              Float?
  fechaInicio      DateTime?
  fechaFinEstimada DateTime?
  fechaFin         DateTime?
  licitacionId     String?
  observaciones    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("obras")
}

model Licitacion {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  numero            String
  tipo              String    @default("Licitacion Publica")
  objeto            String
  montoBase         Float?
  adjudicadoA       String?
  montoAdjudicado   Float?
  estado            String    @default("En preparacion")
  fechaApertura     DateTime?
  fechaAdjudicacion DateTime?
  secretaria        String?
  expediente        String?
  observaciones     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([tenantId, numero])
  @@map("licitaciones")
}

model Documento {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre    String
  tipo      String
  url       String
  size      Int?
  mimeType  String?
  modulo    String?
  entidadId String?
  subidoPor String?
  createdAt DateTime @default(now())

  @@map("documentos")
}

model Notificacion {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipo      String
  titulo    String
  cuerpo    String
  modulo    String?
  href      String?
  leida     Boolean  @default(false)
  userId    String?
  createdAt DateTime @default(now())

  @@map("notificaciones")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String?
  entityId  String?
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model Invitation {
  id        String    @id @default(cuid())
  email     String
  role      Role      @default(TENANT_USER)
  tenantId  String
  token     String    @unique @default(cuid())
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("invitations")
}

model AusenciaGrh {
  id            String          @id
  tenantId      String
  empleadoId    String
  fecha         DateTime
  dias          Float?
  fechaRegreso  DateTime?
  motivoId      String?
  motivoCodigo  String?
  observaciones String?
  periodo       String?
  createdAt     DateTime        @default(now())
  empleado      EmpleadoGrh     @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  motivo        MotivoAusencia? @relation(fields: [motivoId], references: [id])

  @@index([empleadoId])
  @@index([tenantId, fecha])
  @@map("ausencias_grh")
  @@ignore
}

model Barrio {
  id        String   @id
  tenantId  String
  nombre    String
  codigo    String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, nombre])
  @@map("barrios")
  @@ignore
}

model Calle {
  id        String   @id
  tenantId  String
  nombre    String
  codigo    String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("calles")
  @@ignore
}

model CategoriaGrh {
  id        String        @id
  tenantId  String
  codigo    String
  nombre    String
  abrev     String?
  createdAt DateTime      @default(now())
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  empleados EmpleadoGrh[]

  @@unique([tenantId, codigo])
  @@map("categorias_grh")
  @@ignore
}

model Ciudadano {
  id        String    @id
  tenantId  String
  nombre    String
  sexo      String?
  fechaNac  DateTime?
  dni       String?
  cuil      String?
  calle     String?
  numero    String?
  barrio    String?
  localidad String?
  latitud   Float?
  longitud  Float?
  telefono  String?
  email     String?
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([dni])
  @@index([tenantId])
  @@map("ciudadanos")
  @@ignore
}

model ConvenioGrh {
  id        String        @id
  tenantId  String
  codigo    String
  nombre    String
  createdAt DateTime      @default(now())
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  empleados EmpleadoGrh[]

  @@unique([tenantId, codigo])
  @@map("convenios_grh")
  @@ignore
}

model EmpleadoGrh {
  id              String        @id
  tenantId        String
  legajo          String
  nombre          String
  sexo            String?
  fechaNacimiento DateTime?
  dni             String?
  cuil            String?
  grupoSanguineo  String?
  telefono        String?
  email           String?
  calle           String?
  numero          String?
  piso            String?
  dpto            String?
  barrioNombre    String?
  localidad       String?
  provincia       String?       @default("Mendoza")
  latitud         Float?
  longitud        Float?
  fechaIngreso    DateTime?
  fechaEgreso     DateTime?
  activo          Boolean       @default(true)
  sueldoBasico    Float?
  antiguedadAnios Int?
  antiguedadMeses Int?
  horasDiarias    Float?
  horasMensuales  Float?
  lugarTrabajo    String?
  concursado      Boolean?
  profesion       String?
  sectorId        String?
  categoriaId     String?
  gremioId        String?
  convenioId      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  ausencias       AusenciaGrh[]
  categoria       CategoriaGrh? @relation(fields: [categoriaId], references: [id])
  convenio        ConvenioGrh?  @relation(fields: [convenioId], references: [id])
  gremio          GremioGrh?    @relation(fields: [gremioId], references: [id])
  sector          SectorGrh?    @relation(fields: [sectorId], references: [id])
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  familiares      FamiliarGrh[]
  licencias       LicenciaGrh[]

  @@unique([tenantId, legajo])
  @@index([categoriaId])
  @@index([sectorId])
  @@index([tenantId, activo])
  @@map("empleados_grh")
  @@ignore
}

model FamiliarGrh {
  id           String      @id
  empleadoId   String
  nombre       String
  vinculo      String
  fechaNac     DateTime?
  cuil         String?
  sexo         String?
  discapacidad Boolean     @default(false)
  escolaridad  String?
  createdAt    DateTime    @default(now())
  empleado     EmpleadoGrh @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@index([empleadoId])
  @@map("familiares_grh")
  @@ignore
}

model GremioGrh {
  id        String        @id
  tenantId  String
  codigo    String
  nombre    String
  abrev     String?
  createdAt DateTime      @default(now())
  empleados EmpleadoGrh[]
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, codigo])
  @@map("gremios_grh")
  @@ignore
}

model LicenciaGrh {
  id            String      @id
  tenantId      String
  empleadoId    String
  tipo          String?
  fechaInicio   DateTime?
  fechaFin      DateTime?
  dias          Int?
  periodo       String?
  observaciones String?
  createdAt     DateTime    @default(now())
  empleado      EmpleadoGrh @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@index([empleadoId])
  @@index([tenantId])
  @@map("licencias_grh")
  @@ignore
}

model Localidad {
  id        String   @id
  tenantId  String
  nombre    String
  codigo    String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, nombre])
  @@map("localidades")
  @@ignore
}

model MotivoAusencia {
  id        String        @id
  tenantId  String
  codigo    String
  nombre    String
  diasMax   Int?
  conGoce   Boolean       @default(true)
  createdAt DateTime      @default(now())
  ausencias AusenciaGrh[]
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, codigo])
  @@map("motivos_ausencia")
  @@ignore
}

model SectorGrh {
  id        String        @id
  tenantId  String
  codigo    String
  nombre    String
  abrev     String?
  createdAt DateTime      @default(now())
  empleados EmpleadoGrh[]
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, codigo])
  @@map("sectores_grh")
  @@ignore
}
