model ConvenioGrh {
  id        String        @id
  tenantId  String
  codigo    String
  nombre    String
  createdAt DateTime      @default(now())
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  empleados EmpleadoGrh[]

  @@unique([tenantId, codigo])
  @@map("convenios_grh")
  @@ignore
}

model EmpleadoGrh {
  id              String        @id
  tenantId        String
  legajo          String
  nombre          String
  sexo            String?
  fechaNacimiento DateTime?
  dni             String?
  cuil            String?
  grupoSanguineo  String?
  telefono        String?
  email           String?
  calle           String?
  numero          String?
  piso            String?
  dpto            String?
  barrioNombre    String?
  localidad       String?
  provincia       String?       @default("Mendoza")
  latitud         Float?
  longitud        Float?
  fechaIngreso    DateTime?
  fechaEgreso     DateTime?
  activo          Boolean       @default(true)
  sueldoBasico    Float?
  antiguedadAnios Int?
  antiguedadMeses Int?
  horasDiarias    Float?
  horasMensuales  Float?
  lugarTrabajo    String?
  concursado      Boolean?
  profesion       String?
  sectorId        String?
  categoriaId     String?
  gremioId        String?
  convenioId      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  ausencias       AusenciaGrh[]
  categoria       CategoriaGrh? @relation(fields: [categoriaId], references: [id])
  convenio        ConvenioGrh?  @relation(fields: [convenioId], references: [id])
  gremio          GremioGrh?    @relation(fields: [gremioId], references: [id])
  sector          SectorGrh?    @relation(fields: [sectorId], references: [id])
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  familiares      FamiliarGrh[]
  licencias       LicenciaGrh[]

  @@unique([tenantId, legajo])
  @@index([categoriaId])
  @@index([sectorId])
  @@index([tenantId, activo])
  @@map("empleados_grh")
  @@ignore
}

model FamiliarGrh {
