// ============================================================
// SCHEMA.PRISMA v2 - GovTech Municipal Platform
// Multi-tenant: Tenants, Users + full municipal data
// DB: Neon PostgreSQL (serverless) via Prisma
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  INTENDENTE
  TENANT_ADMIN
  TENANT_USER
  CONTADOR
  INSPECTOR
  DEMO
}

enum Plan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
  TRIAL
  DEMO
}

enum TenantStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  CANCELLED
}

model Tenant {
  id              String       @id @default(cuid())
  slug            String       @unique
  name            String
  shortName       String
  province        String?
  country         String       @default("Argentina")
  population      Int?
  logoUrl         String?
  themePrimary    String       @default("#3b82f6")
  themeAccent     String       @default("#6366f1")
  themeBackground String       @default("#060b18")
  contactEmail    String?
  contactPhone    String?
  website         String?
  plan            Plan         @default(DEMO)
  status          TenantStatus @default(TRIAL)
  trialEndsAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  users           User[]
  empleados       Empleado[]
  pagos           Pago[]
  reclamos        Reclamo[]
  obras           Obra[]
  presupuestos    Presupuesto[]
  licitaciones    Licitacion[]
  auditLogs       AuditLog[]
  documentos      Documento[]
  notificaciones  Notificacion[]

  @@map("tenants")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(TENANT_USER)
  tenantId     String?
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  active       Boolean   @default(true)
  avatar       String?
  lastLogin    DateTime?
  loginCount   Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs    AuditLog[]

  @@map("users")
}

model Empleado {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legajo          String
  nombre          String
  apellido        String
  dni             String?
  cargo           String
  categoria       String?
  secretaria      String
  area            String?
  tipoContrato    String    @default("Planta Permanente")
  salarioBruto    Float
  salarioNeto     Float?
  fechaIngreso    DateTime?
  fechaNacimiento DateTime?
  email           String?
  telefono        String?
  domicilio       String?
  estado          String    @default("Activo")
  observaciones   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantId, legajo])
  @@map("empleados")
}

model Pago {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  numero         String?
  proveedor      String
  cuit           String?
  concepto       String
  secretaria     String
  monto          Float
  moneda         String    @default("ARS")
  fecha          DateTime
  fechaPago      DateTime?
  estado         String    @default("Pagado")
  categoria      String?
  comprobanteUrl String?
  observaciones  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("pagos")
}

model Presupuesto {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  secretaria String
  codigo     String?
  programa   String?
  asignado   Float
  ejecutado  Float    @default(0)
  periodo    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, secretaria, periodo])
  @@map("presupuestos")
}

model Reclamo {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  numero        String
  categoria     String
  subcategoria  String?
  descripcion   String
  estado        String    @default("Pendiente")
  prioridad     String    @default("Media")
  barrio        String?
  domicilio     String?
  lat           Float?
  lng           Float?
  nombre        String?
  telefono      String?
  email         String?
  agente        String?
  fechaAsignado DateTime?
  fechaCierre   DateTime?
  observaciones String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tenantId, numero])
  @@map("reclamos")
}

model Obra {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre           String
  descripcion      String?
  contratista      String?
  monto            Float?
  moneda           String    @default("ARS")
  avance           Int       @default(0)
  estado           String    @default("En ejecucion")
  barrio           String?
  domicilio        String?
  lat              Float?
  lng              Float?
  fechaInicio      DateTime?
  fechaFinEstimada DateTime?
  fechaFin         DateTime?
  licitacionId     String?
  observaciones    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("obras")
}

model Licitacion {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  numero            String
  tipo              String    @default("Licitacion Publica")
  objeto            String
  montoBase         Float?
  adjudicadoA       String?
  montoAdjudicado   Float?
  estado            String    @default("En preparacion")
  fechaApertura     DateTime?
  fechaAdjudicacion DateTime?
  secretaria        String?
  expediente        String?
  observaciones     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([tenantId, numero])
  @@map("licitaciones")
}

model Documento {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre    String
  tipo      String
  url       String
  size      Int?
  mimeType  String?
  modulo    String?
  entidadId String?
  subidoPor String?
  createdAt DateTime @default(now())

  @@map("documentos")
}

model Notificacion {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipo      String
  titulo    String
  cuerpo    String
  modulo    String?
  href      String?
  leida     Boolean  @default(false)
  userId    String?
  createdAt DateTime @default(now())

  @@map("notificaciones")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String?
  entityId  String?
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model Invitation {
  id        String    @id @default(cuid())
  email     String
  role      Role      @default(TENANT_USER)
  tenantId  String
  token     String    @unique @default(cuid())
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("invitations")
}